@model List<Student>
@{
    ViewData["Title"] = "Students";
}

<div class="section-head">
    <div>
        <p class="kicker">Admin</p>
        <h1>Students</h1>
        <p class="meta">Search by name or email. Remove a student if needed. The admin account stays in the list.</p>
    </div>
</div>
<form class="searchbar" method="get" asp-controller="Student" asp-action="search">
    <input type="text" name="searchKey" placeholder="Search name or email" />
    <button type="submit">Search</button>
</form>
<div class="table-wrap panel">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Course</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Student s in Model)
            {
                <tr>
                    <td>@s.StudentId</td>
                    <td>@s.Name</td>
                    <td>@s.Email</td>
                    <td>
                        @if (s.Corse != null)
                        {
                            @s.Corse.CorseName
                        }
                    </td>
                    <td>
                        @if (s.Email != "aaazeezeh@gmail.com")
                        {
                            <a asp-action="Delete" asp-route-id="@s.StudentId">Remove</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
