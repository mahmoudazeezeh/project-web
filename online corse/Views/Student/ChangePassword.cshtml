@{
    ViewData["Title"] = "Password";
}

<section class="auth">
    <section class="form-card panel">
        <p class="kicker">Account</p>
        <h1>Change password</h1>
        <p class="meta">This updates the password for the account you are signed in with. Use the new password the next time you sign in.</p>
        @if (ViewBag.Error != null)
        {
            <p class="err">@ViewBag.Error</p>
        }
        <form asp-action="ChangePassword" asp-controller="Student" method="post">
            <label>New password</label>
            <input type="password" name="newPass" required autocomplete="new-password" />
            <div class="actions">
                <button type="submit">Save password</button>
                <a class="btn btn-ghost" asp-action="sDetails">Cancel</a>
            </div>
        </form>
    </section>
</section>
