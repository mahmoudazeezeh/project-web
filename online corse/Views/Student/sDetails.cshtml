@model Student
@{
    ViewData["Title"] = "Account";
}

<section class="desk">
    <div class="panel">
        <p class="kicker">My profile</p>
        <h1>@Model.Name</h1>
        <p class="meta">@Model.Email</p>
        <dl class="facts">
            <div>
                <dt>Student ID</dt>
                <dd>@Model.StudentId</dd>
            </div>
            <div>
                <dt>Average</dt>
                <dd>@Model.Average</dd>
            </div>
        </dl>
        <div class="actions">
            <a class="btn" asp-action="ChangePassword">Change password</a>
            <a class="btn btn-ghost" asp-action="Logout">Log out</a>
        </div>
    </div>
    <aside class="panel">
        <p class="kicker">Enrolled course</p>
        @if (Model.Corse != null)
        {
            <h2>@Model.Corse.CorseName</h2>
            <p class="meta">@Model.Corse.Instructor</p>
            <p class="price">$@Model.Corse.CosrePrice</p>
        }
        <a class="btn btn-ghost" asp-action="Courses">Change course</a>
    </aside>
</section>
